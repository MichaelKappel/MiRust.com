profile: mirust.file-handoff.v1
updated_utc: 2026-07-01T03:10:00Z
site: MiRust.com
setup_route: https://uaix.org/en-us/tools/ai-memory-package-wizard/#setup-file-handoff
active_buckets:
  content: agent-file-handoff/Content/
  improvement: agent-file-handoff/Improvement/
rules:
  - Scan both active buckets before broad work.
  - Review every non-placeholder file.
  - Record disposition and proof of use in .uai/intake-outcome-ledger.uai.
  - Preserve durable evidence when accepted.
  - Remove processed source-site copies unless a human explicitly keeps them active.
placeholder_files:
  - agent-file-handoff/Content/.gitkeep
  - agent-file-handoff/Improvement/.gitkeep
completion_gate: Active buckets must be empty or placeholder-only after processing.
